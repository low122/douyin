# Do not copy this file over .env — that wipes every generated secret and every
# key you pasted in. Run this instead, first time and every time this file gains
# a new setting. It fills blanks, adds missing keys, and never touches a value
# that already exists:
#
#   python3 scripts/setup_env.py
#
# Never commit .env.

# ---------------------------------------------------------------- required --

# Shared secret for the ingest API and the admin UI.
# The service refuses to start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Postgres password used by docker-compose and the app.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- optional --

ENVIRONMENT=development          # "production" disables the /docs page
LOG_LEVEL=INFO

# Only needed when running the app outside docker-compose.
# Inside compose this is set for you and points at the `db` service.
DATABASE_URL=postgresql+asyncpg://douyin:CHANGEME@localhost:5432/douyin
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------- model tasks --
# Each AI step resolves to a provider and model independently (ADR-0004).
# The defaults below point every task at one provider, so a fresh install
# needs exactly one key. Split them across providers only if you want to.

# Any OpenAI-compatible provider works per task. Set {TASK}_PROVIDER and
# {TASK}_MODEL; the base URL is filled in for known providers.
DEEPSEEK_API_KEY=

OPENAI_API_KEY=

# whisper-1 is the only transcription model that returns timestamps, and a
# moment is defined by its start and end — so this is a capability requirement,
# not a preference. The newer models are cheaper, faster, and transcribe Chinese
# better, and all three reject verbose_json. Do not "upgrade" this without
# checking that the replacement can still emit segments. See ADR-0007.
#   whisper-1                $0.006/min   timestamps ✓
#   gpt-4o-mini-transcribe   $0.003/min   timestamps ✗
#   gpt-transcribe           $0.0045/min  timestamps ✗
#   gpt-4o-transcribe        $0.006/min   timestamps ✗
TRANSCRIBE_PROVIDER=openai
TRANSCRIBE_MODEL=whisper-1


# Not the mini model, and not for the reason you would guess. Measured on one
EXTRACT_PROVIDER=openai
EXTRACT_MODEL=gpt-4o

EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small

# Example of splitting a task onto a second provider. Any OpenAI-compatible
# endpoint works by setting the matching *_BASE_URL.
#   EXTRACT_PROVIDER=openai_compatible
#   EXTRACT_BASE_URL=https://api.deepseek.com
#   EXTRACT_MODEL=<model-id>
#   EXTRACT_API_KEY=<key>
